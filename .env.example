# Database connection string used by Prisma and the app runtime.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/plandesign"

# Auth.js / NextAuth secret used to sign sessions and tokens.
AUTH_SECRET="replace-with-a-strong-random-secret"

# Public application URL used by auth callbacks.
NEXTAUTH_URL="http://localhost:3000"

# Runtime environment. Use production on deployed environments.
NODE_ENV="production"
