generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  architect
  interior_designer
  employee
  client
}

enum ProjectStage {
  discovery
  design
  approval
  execution
  handover
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
  archived
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  canceled
}

enum SupplierCategory {
  furniture
  electrical
  plumbing
  materials
  contractors
}

enum ExpenseCategory {
  materials
  labor
  logistics
  furniture
  permits
  equipment
  supplier_payment
  other
}

enum SupplierPaymentStatus {
  pending
  approved
  paid
  failed
}

enum ProcurementStatus {
  requested
  approved
  rejected
  ordered
  delivered
}

enum TaskStatus {
  todo
  in_progress
  review
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum AttachmentOwnerType {
  client
  project
}

enum NotificationType {
  info
  success
  warning
  error
}

enum ActivityEntityType {
  client
  project
  invoice
  task
  meeting
  file
  notification
}

enum ActivityEventType {
  client_created
  note_added
  file_uploaded
  meeting_scheduled
  project_created
  task_created
  task_moved
  comment_added
  invoice_created
  invoice_status_changed
  expense_logged
  member_assigned
  supplier_attached
}

// ─── Auth models (NextAuth Prisma Adapter) ────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core models ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(client)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  assignedClients   Client[]
  projectMemberships ProjectMember[]
  assignedTasks     Task[]          @relation("TaskAssignee")
  createdTasks      Task[]          @relation("TaskCreator")
  meetingAttendances MeetingAttendee[]
  clientNotes       ClientNote[]    @relation("ClientNoteAuthor")
  projectComments   ProjectComment[] @relation("ProjectCommentAuthor")
  uploadedFiles     Attachment[]    @relation("AttachmentUploader")
  notifications     Notification[]
  activityEvents    ActivityEvent[] @relation("ActivityActor")
  expenses          Expense[]       @relation("ExpenseCreator")
}

model Client {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  email        String?
  address      String?
  notes        String?
  status       String   @default("active")
  industry     String?
  website      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedToId String?
  assignedTo   User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  projects     Project[]
  invoices     Invoice[]
  meetings     Meeting[]
  clientNotes  ClientNote[]
  attachments  Attachment[]
  activities   ActivityEvent[]
  expenses     Expense[]
}

model Project {
  id          String       @id @default(cuid())
  name        String
  stage       ProjectStage @default(discovery)
  status      ProjectStatus @default(active)
  budget      Decimal      @db.Decimal(12, 2)
  spent       Decimal      @default(0) @db.Decimal(12, 2)
  progress    Int          @default(0)
  description String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  clientId String?
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  members  ProjectMember[]
  invoices Invoice[]
  tasks    Task[]
  meetings Meeting[]
  comments ProjectComment[]
  attachments Attachment[]
  activities ActivityEvent[]
  supplierLinks ProjectSupplier[]
  procurementRequests ProcurementRequest[]
  expenses Expense[]
}

model ProjectMember {
  userId    String
  projectId String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model Invoice {
  id        String        @id @default(cuid())
  number    String        @unique
  status    InvoiceStatus @default(draft)
  amount    Decimal       @db.Decimal(12, 2)
  subtotal  Decimal       @default(0) @db.Decimal(12, 2)
  taxRate   Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount Decimal     @default(0) @db.Decimal(12, 2)
  notes     String?
  issuedAt  DateTime?
  dueAt     DateTime?
  paymentDate DateTime?
  canceledAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  activities ActivityEvent[]
}

model Supplier {
  id        String           @id @default(cuid())
  name      String
  category  SupplierCategory
  phone     String?
  email     String?
  city      String?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  projects  ProjectSupplier[]
  expenses  Expense[]
  procurementRequests ProcurementRequest[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueAt       DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    User?    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  activities ActivityEvent[]
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  duration  Int      @default(60)
  location  String?
  room      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  attendees MeetingAttendee[]
  activities ActivityEvent[]
}

model MeetingAttendee {
  userId    String
  meetingId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@id([userId, meetingId])
}

model ClientNote {
  id          String   @id @default(cuid())
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation("ClientNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String?

  @@index([clientId, createdAt])
}

model Attachment {
  id            String              @id @default(cuid())
  name          String
  url           String
  mimeType      String
  size          Int
  ownerType     AttachmentOwnerType
  createdAt     DateTime            @default(now())
  clientId      String?
  client        Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById  String?
  uploadedBy    User?               @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ownerType, createdAt])
  @@index([clientId, createdAt])
  @@index([projectId, createdAt])
}

model ProjectComment {
  id          String   @id @default(cuid())
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation("ProjectCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String?

  @@index([projectId, createdAt])
}

model ProjectSupplier {
  projectId   String
  supplierId  String
  attachedAt  DateTime @default(now())
  assignedPhase ProjectStage @default(execution)
  notes       String?

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([projectId, supplierId])
}

model Expense {
  id          String   @id @default(cuid())
  label       String
  category    ExpenseCategory
  amount      Decimal  @db.Decimal(12, 2)
  recurring   Boolean  @default(false)
  receiptUrl  String?
  paymentStatus SupplierPaymentStatus?
  occurredAt  DateTime
  notes       String?
  createdAt   DateTime @default(now())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([projectId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([supplierId, occurredAt])
  @@index([paymentStatus, occurredAt])
}

model ProcurementRequest {
  id             String           @id @default(cuid())
  title          String
  phase          ProjectStage
  status         ProcurementStatus @default(requested)
  requestedBy    String
  requestedAt    DateTime         @default(now())
  approvedBy     String?
  approvedAt     DateTime?
  selectedQuoteId String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  supplierId     String
  supplier       Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotes         ProcurementQuote[]

  @@index([supplierId, createdAt])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

model ProcurementQuote {
  id             String            @id @default(cuid())
  supplierLabel  String
  amount         Decimal           @db.Decimal(12, 2)
  currency       String
  etaDays        Int?
  notes          String?
  createdAt      DateTime          @default(now())

  requestId      String
  request        ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  type        NotificationType @default(info)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  readAt      DateTime?
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType  ActivityEntityType?
  entityId    String?

  @@index([userId, isRead, createdAt])
}

model ActivityEvent {
  id          String             @id @default(cuid())
  eventType   ActivityEventType
  entityType  ActivityEntityType
  entityId    String
  title       String
  description String
  metadata    Json?
  createdAt   DateTime           @default(now())

  actorId     String?
  actor       User?              @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String?

  clientId    String?
  client      Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  meetingId   String?
  meeting     Meeting?           @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId, createdAt])
  @@index([clientId, createdAt])
  @@index([projectId, createdAt])
}